# Public widget key. Set before building the site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only Cloudflare secret. Never prefix with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=
# Exact origins, comma-separated, without trailing slashes.
CONTACT_ALLOWED_ORIGINS=https://your-project.vercel.app,https://your-domain.example
# Server-only Resend API key. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Optional. Sender must belong to a domain verified in Resend.
RESEND_FROM=Site SIAC <contato@envios.siac.tech>
